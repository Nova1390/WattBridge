NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Never expose vendor credentials in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# Local discovery only. Do not set these in Vercel public/client env.
ENPHASE_ACCESS_TOKEN=
ENPHASE_REFRESH_TOKEN=
ENPHASE_API_KEY=
ENPHASE_CLIENT_ID=
ENPHASE_CLIENT_SECRET=
ENPHASE_AUTH_CODE=
ENPHASE_REDIRECT_URI=https://api.enphaseenergy.com/oauth/redirect_uri
ENPHASE_WRITE_ENV=false
ENPHASE_DISCOVERY_DELAY_MS=6500
ENPHASE_SYSTEM_ID=
